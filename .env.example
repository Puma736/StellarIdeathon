# Copiar a .env y completar. Lo genera `npm run cuentas` (scripts/cuentas.mjs).
# Solo testnet, solo demo: las claves secretas de los sobres viven aquí porque
# la billetera paga desde ellos sin extensión ni login.

# Emisor: firma el envío desde Madrid y emite USDp.
VITE_SENDER_SECRET=

# Issuer de USDp. Si se deja vacío se deriva de VITE_SENDER_SECRET.
VITE_ASSET_ISSUER=
VITE_ASSET_CODE=USDp

# Sobres de la familia en La Paz.
VITE_CASA_SECRET=
VITE_COLEGIO_SOBRE_SECRET=
VITE_SALUD_SECRET=

# El comercio que cobra (el colegio).
VITE_COLEGIO_PUBLIC=

# Cuenta de Reparte: recibe el 1%.
VITE_FEE_PUBLIC=
